{
  "name": "bmad-implementation-supervisor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "BMAD Implementation Supervisor - automates the Implementation Phase of the BMAD Method",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@grammyjs/menu": "^1.3.1",
    "chokidar": "^5.0.0",
    "grammy": "^1.32.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sql.js": "^1.11.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/bun": "^1.2.5",
    "tsx": "^4.19.2"
  }
}